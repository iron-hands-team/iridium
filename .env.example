DB_USER="user"
DB_PASSWORD="YOUR_DATABASE_PASSWORD"
JWT_SECRET_KEY="YOUR_SECRET_KEY"
TOTP_ENCRYPTION_KEY="" # encrypts 2FA secrets; install.sh generates it (openssl rand -base64 32 | tr "+/" "-_")
FRONTEND_URL="https://localhost"
GARAGE_RPC_SECRET="YOUR_GARAGE_RPC_SECRET" #generate with `openssl rand -hex 32`
GARAGE_ACCESS_KEY="YOUR_GARAGE_ACCESS_KEY" #see instructions in README
GARAGE_SECRET_KEY="YOUR_GARAGE_SECRET_KEY"
ENVIRONMENT="development" # set to "production" for real deployments
ADMIN_PASSWORD="" # initial admin password; in production a random one is printed once if left empty
SEED_DEMO_DATA="" # set to "true" to seed demo people and content even in production
SITE_ADDRESS="localhost" # your domain in production, e.g. school.example.com
